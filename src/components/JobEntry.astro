---
import type { Job } from '../data/types';

interface Props {
  job: Job;
}

const { job } = Astro.props;
---
<section class="job">
  <header>
    <h3><b>{job.org}</b> <span>— {job.role}</span></h3>
    <span class="when">{job.when}</span>
  </header>
  <p class="context">{job.context}</p>
  {job.groups.map((g) => (
    <div class="group">
      <h4>{g.name}</h4>
      <ul>
        {g.points.map((p) => <li>{p}</li>)}
      </ul>
    </div>
  ))}
  <p class="stack">{job.stack.join(' · ')}</p>
</section>

<style>
  .job { display: flex; flex-direction: column; gap: 10px; break-inside: avoid-page; }
  header { display: flex; justify-content: space-between; align-items: baseline; gap: 4px 16px; flex-wrap: wrap; }
  h3 { font-size: 17px; font-weight: 400; }
  h3 span { color: var(--ink-3); }
  .when { font-size: 13px; color: var(--muted); white-space: nowrap; font-variant-numeric: tabular-nums; }
  .context { font-size: 13px; color: var(--muted); }
  .group { display: flex; flex-direction: column; gap: 4px; padding-left: 16px; border-left: 1px solid var(--line); }
  h4 { margin: 0; font-size: 14px; font-weight: 700; }
  ul { margin: 0; padding-left: 2ch; list-style-type: '- '; font-size: 14px; line-height: 1.7; color: var(--ink-2); }
  .stack { font-size: 12px; color: var(--muted); }

  @media print {
    .job { gap: 4px; }
    h3 { font-size: 11pt; }
    .when, .context, .stack { font-size: 8pt; }
    .group { padding-left: 8px; gap: 1px; }
    h4 { font-size: 9pt; }
    ul { font-size: 8.5pt; line-height: 1.45; }
  }
</style>
