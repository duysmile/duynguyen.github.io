---
import type { LogLine } from '../data/types';
import { buildMacbook } from '../lib/ascii/macbook';

interface Props {
  lines: LogLine[];
}

const { lines } = Astro.props;

// A log line too long for the screen stops the build here, not in a visitor's browser.
buildMacbook(lines);

// Text terminal: phones, and browsers where the canvas cannot run.
const TITLE = 'bean -- tail';
const COMMAND = '$ tail -f /var/log/bean.log';
const rows = lines.map((l) => ({ ...l, when: l.when.padEnd(4, ' '), tag: l.level === 'OK' ? ' OK ' : 'INFO' }));
const inner = Math.ceil(Math.max(COMMAND.length, ...rows.map((r) => 10 + r.msg.length)) / 2) * 2 + 2;
const gap = inner - 7 - TITLE.length;
const pad = (used: number) => ' '.repeat(inner - 1 - used);
const rule = '-'.repeat(inner + 2);
---
<figure class="laptop" aria-label="Career log on a laptop screen">
  <canvas class="mac" aria-hidden="true" data-log={JSON.stringify(lines)}></canvas>
  <pre class="term" aria-hidden="true" style={`--cols:${inner + 4}`}><span class="row">.{rule}.</span>{'\n'}<span class="row">|  <span class="r">o</span> <span class="y">o</span> <span class="g">o</span>{' '.repeat(Math.floor(gap / 2))}<span class="dim">{TITLE}</span>{' '.repeat(gap - Math.floor(gap / 2))}  |</span>{'\n'}<span class="row">|{rule}|</span>{'\n'}<span class="row">|  <span class="dim">{COMMAND}</span>{pad(COMMAND.length)} |</span>{'\n'}{rows.map((r) => (
    <Fragment><span class="row">|  <span class="dim">{r.when}</span> <span class={r.level === 'OK' ? 'ok' : 'info'}>{r.tag}</span> <span class="msg">{r.msg}</span>{pad(10 + r.msg.length)} |</span>{'\n'}</Fragment>
  ))}<span class="row">|  <span class="cursor">_</span>{pad(1)} |</span>{'\n'}<span class="row">'{rule}'</span></pre>
  <ol class="sr">
    {lines.map((l) => <li>{l.when}: {l.msg}</li>)}
  </ol>
</figure>
<noscript>
  <style is:inline>
    .laptop .mac { display: none !important; }
    .laptop .term { display: block !important; }
  </style>
</noscript>

<script>
  import { buildMacbook, frameAt, introEnd, isShown, MAC_TONES, SETTLED, shimmer, sourceRow } from '../lib/ascii/macbook';
  import { drawMode } from '../lib/ascii/motion';
  import { fitFont, paintGrid } from '../lib/ascii/paint';

  const SETTLED_FRAME_MS = 125;
  const SHIMMER_CELLS = 260;

  const figure = document.querySelector<HTMLElement>('figure.laptop');
  const canvas = figure?.querySelector<HTMLCanvasElement>('canvas.mac') ?? null;
  const ctx = canvas?.getContext('2d') ?? null;

  if (figure && canvas && ctx) {
    const mac = buildMacbook(JSON.parse(canvas.dataset.log ?? '[]'));
    const reduced = matchMedia('(prefers-reduced-motion: reduce)');
    const root = getComputedStyle(document.documentElement);
    const family = root.getPropertyValue('--font');
    const wall = root.getPropertyValue('--wall');
    const settledAt = introEnd(mac.lines) + 0.2;
    const started = performance.now();
    let cell = 0;
    let row = 0;
    let last = 0;
    let raf = 0;

    const mode = () => drawMode({ canvas: true, reduced: reduced.matches, still: false, hidden: document.hidden });

    const draw = (t: number) => {
      if (!cell) return;
      const frame = frameAt(t, mac.lid, mac.lines);
      const top = mac.lid - frame.lidRows;
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      // Hide the sky behind the laptop.
      ctx.fillStyle = wall;
      ctx.fillRect(6 * cell, top * row, (mac.cols - 12) * cell, frame.lidRows * row);
      ctx.fillRect(0, mac.lid * row, mac.cols * cell, (mac.rows - mac.lid) * row);
      paintGrid(ctx, mac, MAC_TONES, row, {
        from: top,
        source: (y) => sourceRow(y, mac.lid, frame.lidRows),
        shown: (c) => isShown(mac, frame, c),
      });
    };

    const resize = () => {
      const width = canvas.clientWidth;
      // Hidden below 640px: the text terminal shows there.
      if (!width) return;
      const dpr = Math.min(devicePixelRatio || 1, 3);
      canvas.width = Math.round(width * dpr);
      canvas.height = Math.round(canvas.clientHeight * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      cell = width / mac.cols;
      row = canvas.clientHeight / mac.rows;
      fitFont(ctx, family, cell);
      draw(mode() === 'still' ? SETTLED : (performance.now() - started) / 1000);
    };

    const tick = (time: number) => {
      raf = 0;
      if (mode() !== 'animate') return;
      raf = requestAnimationFrame(tick);
      const t = (time - started) / 1000;
      const settled = t > settledAt;
      if (settled && time - last < SETTLED_FRAME_MS) return;
      last = time;
      if (settled) shimmer(mac, Math.random, SHIMMER_CELLS);
      draw(t);
    };

    const run = () => {
      if (mode() === 'still') draw(SETTLED);
      else if (!raf && mode() === 'animate') raf = requestAnimationFrame(tick);
    };

    resize();
    addEventListener('resize', resize);
    document.addEventListener('visibilitychange', run);
    reduced.addEventListener('change', run);
    run();
  } else {
    figure?.setAttribute('data-plain', '');
  }
</script>

<style>
  .laptop { position: relative; margin: 0; width: min(640px, 100%); container-type: inline-size; }

  /* 244 x 121 cells; a row is 0.75 of the font size and a cell is 0.6 of it. The ratio holds the space before the script runs. */
  .mac { display: block; width: 100%; aspect-ratio: 244 / 151.25; }

  .term {
    display: none;
    margin: 0;
    font: inherit;
    font-size: min(15px, calc(100cqi / (var(--cols) * 0.602)));
    line-height: 1.25;
    color: var(--muted);
    white-space: pre;
  }
  .row { background: var(--wall); }
  .dim { color: var(--screen-dim); }
  .ok { color: var(--screen-ok); }
  .info { color: var(--screen-info); }
  .msg { color: var(--screen-ink); }
  .r { color: #d9564b; }
  .y { color: #c99a2e; }
  .g { color: #3f9a55; }
  .cursor { color: var(--screen-ink); animation: blink 1.1s steps(1) infinite; }

  .sr { position: absolute; width: 1px; height: 1px; margin: 0; padding: 0; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }

  .laptop[data-plain] .mac { display: none; }
  .laptop[data-plain] .term { display: block; }
  @media (max-width: 640px) {
    .mac { display: none; }
    .term { display: block; }
  }

  @keyframes blink { 50% { opacity: 0; } }
</style>
