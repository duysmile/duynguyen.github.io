---
import type { LogLine } from '../data/types';

interface Props {
  lines: LogLine[];
}

const { lines } = Astro.props;
---
<figure class="laptop" aria-label="Career log on a laptop screen">
  <div class="lid">
    <div class="screen">
      <p class="bar" aria-hidden="true">bean@duysmile: ~</p>
      <p class="cmd">$ tail -f /var/log/bean.log</p>
      <ol class="log">
        {lines.map((l, i) => (
          <li style={`--i:${i}`}>
            <span class="when">{l.when.padEnd(4, ' ')}</span>{' '}
            <span class:list={['lvl', l.level === 'OK' ? 'ok' : 'info']}>{l.level === 'OK' ? ' OK ' : 'INFO'}</span>{' '}
            <span class="msg">{l.msg}</span>
          </li>
        ))}
      </ol>
      <span class="cursor" aria-hidden="true"></span>
    </div>
  </div>
  <div class="base" aria-hidden="true"><span></span></div>
</figure>

<style>
  .laptop { margin: 0; width: min(640px, 100%); display: flex; flex-direction: column; align-items: center; }
  .lid {
    width: 86%;
    aspect-ratio: 16 / 10.4;
    background: #15181b;
    border: 2px solid #8c939a;
    border-bottom: 0;
    border-radius: 16px 16px 4px 4px;
    padding: 2.2% 2.2% 3.4%;
  }
  .screen {
    height: 100%;
    background: var(--screen);
    border-radius: 4px;
    padding: 5% 5.5%;
    color: var(--screen-ink);
    font-size: clamp(9.5px, 1.9vw, 13.5px);
    line-height: 1.75;
    overflow: hidden;
  }
  .cmd { color: var(--screen-dim); }
  .log { list-style: none; margin: 0; padding: 0; }
  .log li {
    white-space: pre-wrap;
    padding-left: 10ch;
    text-indent: -10ch;
    opacity: 0;
    animation: line-in 260ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
    animation-delay: calc(80ms + var(--i) * 70ms);
  }
  .when { color: #7f8c97; }
  .ok { color: var(--screen-ok); }
  .info { color: var(--screen-info); }
  .msg { color: #a9bab0; }
  .cursor {
    display: inline-block;
    width: 0.6em;
    height: 1.15em;
    margin-top: 2px;
    background: var(--screen-ink);
    animation: blink 1.1s steps(1) infinite;
  }
  .base {
    width: 100%;
    height: 16px;
    background: #b4bac0;
    border-radius: 2px 2px 14px 14px;
    display: flex;
    justify-content: center;
    box-shadow: 0 12px 20px -6px rgb(20 24 28 / 0.4);
  }
  .base span { width: 17%; height: 6px; background: #969ca3; border-radius: 0 0 8px 8px; }
  .bar { display: none; }
  @media (max-width: 640px) {
    .lid { width: 100%; aspect-ratio: auto; background: none; border: 0; padding: 0; }
    .base { display: none; }
    .screen {
      border-radius: 8px;
      padding: 0 16px 16px;
      font-size: 12px;
      box-shadow: 0 10px 24px -8px rgb(20 24 28 / 0.35);
    }
    .bar {
      display: block;
      margin: 0 -16px 12px;
      padding: 9px 16px;
      border-bottom: 1px solid #222a31;
      color: var(--screen-dim);
      font-size: 11px;
    }
  }

  @keyframes line-in {
    from { opacity: 0; transform: translateY(4px); filter: blur(2px); }
    to { opacity: 1; transform: none; filter: none; }
  }
  @keyframes blink { 50% { opacity: 0; } }

  @media (prefers-reduced-motion: reduce) {
    .log li { opacity: 1; }
  }
</style>
