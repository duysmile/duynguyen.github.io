---
// x: % from the left of the glass; d: delay in s. Negative delays start mid-flight, so steam is visible on load.
const bits = [
  { c: '1', x: 30, d: 0 },
  { c: '0', x: 50, d: -1.5 },
  { c: '1', x: 38, d: -3 },
  { c: '0', x: 46, d: -4.5 },
];
---
<span class="mug" aria-hidden="true">
  <span class="steam">
    {bits.map((b) => <span data-bit={b.c} style={`left:${b.x}%;animation-delay:${b.d}s`}></span>)}
  </span>
  <svg class="glass" viewBox="0 72 100 78">
    <path d="M16 72 H80 L76 138 A6 6 0 0 1 70 144 H26 A6 6 0 0 1 20 138 Z" fill="#e3e7eb" stroke="#8c939a" stroke-width="2" />
    <path d="M18.6 80 H77.4 L76.6 92 H19.4 Z" fill="#f4ede4" />
    <path d="M19.4 92 H76.6 L75.4 112 H20.6 Z" fill="#c8a47c" />
    <path d="M20.6 112 H75.4 L74.4 136 A5 5 0 0 1 69.6 141 H26.4 A5 5 0 0 1 21.6 136 Z" fill="#6b4a33" />
    <path d="M26 82 V134" stroke="#ffffff" stroke-width="3" stroke-linecap="round" opacity="0.7" />
  </svg>
</span>

<style>
  .mug { position: absolute; inset: 0; }
  .glass { position: absolute; left: 0; bottom: -0.06em; width: 100%; overflow: visible; }
  .steam { position: absolute; left: 0; right: 0; bottom: 0.66em; height: 1em; }
  .steam span {
    position: absolute;
    bottom: 0;
    font-size: 0.3em;
    font-weight: 500;
    line-height: 1;
    color: #7f8c97;
    opacity: 0;
    animation: bit 6s cubic-bezier(0.33, 0, 0.4, 1) infinite;
  }
  /* Generated content keeps the digits out of the headline's text (SEO, copy-paste). */
  .steam span::before { content: attr(data-bit); }
  @keyframes bit {
    0% { opacity: 0; transform: translate(0, 0); }
    18% { opacity: 1; }
    55% { transform: translate(0.25em, -1.4em); }
    100% { opacity: 0; transform: translate(-0.15em, -2.8em); }
  }
  @media (prefers-reduced-motion: reduce) {
    .steam span { animation: none; opacity: 0.6; }
    .steam span:nth-child(n + 4) { display: none; }
    .steam span:nth-child(2) { bottom: 1.2em; }
    .steam span:nth-child(3) { bottom: 2.4em; }
  }
</style>
